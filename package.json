{
  "name": "petit-meme",
  "version": "0.1.0",
  "private": true,
  "description": "Meme management and sharing platform with video support, premium subscriptions, and a TikTok-style reels experience.",
  "license": "UNLICENSED",
  "author": "Victor de la Fouchardiere",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "build:e2e": "vite build --mode e2e",
    "start:e2e": "dotenv run --override -f .env.e2e -- node .output/server/index.mjs",
    "prisma:migrate:dev": "dotenv run -f .env.development -- prisma migrate deploy",
    "prisma:migrate:e2e": "dotenv run --override -f .env.e2e -- prisma migrate deploy || dotenv run --override -f .env.e2e -- prisma migrate deploy",
    "prisma:migrate:prod": "dotenv run -f .env.production -- prisma migrate deploy",
    "prisma:seed:dev": "vite-node --mode development prisma/seed.ts",
    "prisma:reset-db:dev": "dotenv run -f .env.development -- prisma migrate reset",
    "avatars:generate": "pnpm dlx tsx scripts/generate-avatars.ts",
    "postinstall": "paraglide-js compile --project ./project.inlang && node scripts/copy-ffmpeg.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "turbo run typecheck lint test format:check",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && pnpm run format && tsc",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "email:dev": "email dev --dir src/emails --port 3001",
    "prepare": "husky"
  },
  "dependencies": {
    "@algolia/client-insights": "^5.60.0",
    "@algolia/client-search": "^5.60.0",
    "@algolia/recommend": "^5.60.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/prisma-adapter": "^1.7.13",
    "@better-auth/stripe": "^1.7.13",
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^2.31.0",
    "@number-flow/react": "^0.6.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/browser": "11.9.0",
    "@sentry/tanstackstart-react": "11.9.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-anthropic": "^1.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-pacer": "^0.24.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@vercel/functions": "^3.10.1",
    "better-auth": "^1.7.13",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "filesize": "^11.0.29",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.61.0",
    "media-chrome": "^4.19.4",
    "motion": "^14.6.0",
    "nitro": "3.0.260903-beta",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "6.11.3",
    "react-error-boundary": "^6.1.6",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "react-tweet": "^3.3.1",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.35.0",
    "schema-dts": "^2.1.0",
    "sonner": "^2.0.8",
    "spin-delay": "^2.0.1",
    "stripe": "~23.0.1",
    "tailwindcss": "^4.3.3",
    "takumi-js": "2.18.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@inlang/paraglide-js": "2.29.1",
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "1.64.1",
    "@react-email/ui": "6.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@tanstack/intent": "0.5.6",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@viclafouch/oxc-config": "1.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "eslint-plugin-playwright": "^2.12.1",
    "husky": "^9.1.7",
    "oxc-transform-react": "~0.152.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
