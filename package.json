{
  "name": "petit-meme",
  "version": "0.1.0",
  "private": true,
  "description": "Meme management and sharing platform with video support, premium subscriptions, and a TikTok-style reels experience.",
  "license": "UNLICENSED",
  "author": "Victor de la Fouchardiere",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "build:e2e": "vite build --mode e2e",
    "start:e2e": "dotenv -e .env.e2e -- node .output/server/index.mjs",
    "prisma:migrate:dev": "dotenv -e .env.development -- prisma migrate deploy",
    "prisma:migrate:e2e": "dotenv -e .env.e2e -- prisma migrate deploy || dotenv -e .env.e2e -- prisma migrate deploy",
    "prisma:migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "prisma:seed:dev": "vite-node --mode development prisma/seed.ts",
    "prisma:reset-db:dev": "dotenv -e .env.development -- prisma migrate reset",
    "avatars:generate": "pnpm dlx tsx scripts/generate-avatars.ts",
    "postinstall": "paraglide-js compile --project ./project.inlang && node scripts/copy-ffmpeg.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "turbo run typecheck lint test format:check",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "tsc && oxlint --fix && pnpm run format",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "email:dev": "email dev --dir src/emails --port 3001",
    "prepare": "husky"
  },
